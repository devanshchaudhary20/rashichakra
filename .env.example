# Instagram API (Instagram Login flow)
IG_LONG_LIVED_TOKEN=
IG_USER_ID=
IG_APP_ID=
IG_APP_SECRET=

# GitHub repo (for hosting the rendered images via raw.githubusercontent.com)
GITHUB_REPO=
GITHUB_BRANCH=main

# Account display info (caption signature)
IG_HANDLE=@your_handle_here

# Optional: cover slide filename inside data/zodiac_images/ (default: cover.jpg / .jpeg / .png)
# COVER_IMAGE=cover.png
